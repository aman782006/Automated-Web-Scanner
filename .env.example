# =============================================================================
# Automated Web Security Scanner - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust the values as needed:
#   copy .env.example .env (Windows)
#   cp .env.example .env   (Linux/macOS)
# =============================================================================

# Flask Environment: development | testing | production
FLASK_ENV=development

# Secret Key for session signing & CSRF protection
# If left empty, an ephemeral random 32-byte key is automatically generated on startup
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Server settings (used when running via python app.py)
PORT=5000
HOST=127.0.0.1
